# Caminho para o cards.json e a pasta de imagens (pasta riftbound/ do projeto)
CARDS_SOURCE=./data/source/cards.json
IMAGES_SOURCE=./data/source/imagens

# Postgres (Supabase Free ou Docker local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/central_riftbound

# Cloudflare R2 (opcional; sem isso as imagens ficam só em data/images/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=central-riftbound-cards
NEXT_PUBLIC_IMAGE_BASE_URL=
