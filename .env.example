# Caminho para o cards.json e a pasta de imagens (pasta riftbound/ do projeto)
CARDS_SOURCE=./data/source/cards.json
IMAGES_SOURCE=./data/source/imagens

# Postgres (Supabase Free ou Docker local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/central_riftbound

# Segredo da rota /api/cron/live-tick (o pg_cron do Supabase manda no Authorization)
CRON_SECRET=

# Supabase Storage (imagens): só para pnpm upload:images
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_IMAGE_BASE_URL=

# Login (Supabase Auth). Sem estas duas, o site funciona sem login.
# A publishable key é pública por natureza; o banco fica protegido por RLS (migração 0003).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Provedores ligados no painel do Supabase, separados por vírgula: discord, google
NEXT_PUBLIC_AUTH_PROVIDERS=discord
# Endereço do site para o retorno do login (opcional; sem ele, usa o host da requisição)
SITE_URL=

# TopDeck.gg (decklists e eventos grandes): chave grátis em https://topdeck.gg (opcional)
TOPDECK_API_KEY=
